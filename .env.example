# Authorized Email Lists
# Comma-separated list of admin emails (full access to content management)
ADMIN_EMAILS=admin@example.com,admin2@example.com
# Comma-separated list of pro emails (get pro tier access without subscription)
PRO_EMAILS=pro@example.com,team@example.com
# Client-side pro emails (for UI hints only - server always verifies)
NEXT_PUBLIC_PRO_EMAILS=pro@example.com,team@example.com

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a $150/month recurring price in Stripe Dashboard
# Products > Add Product > Add recurring price of $150/month
# Copy the price ID (starts with price_)
STRIPE_PRICE_ID=price_...

# Webhook secret for handling Stripe events
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Your application URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Email service (optional - for Formspree)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id
