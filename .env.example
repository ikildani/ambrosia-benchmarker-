# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API (for AI-powered features)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Authorized Email Lists
# Comma-separated list of admin emails (full access to content management)
ADMIN_EMAILS=admin@example.com,admin2@example.com
# Comma-separated list of pro emails (get pro tier access without subscription)
PRO_EMAILS=pro@example.com,team@example.com
# Client-side pro emails (for UI hints only - server always verifies)
NEXT_PUBLIC_PRO_EMAILS=pro@example.com,team@example.com

# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a $150/month recurring price in Stripe Dashboard
# Products > Add Product > Add recurring price of $150/month
# Copy the price ID (starts with price_)
STRIPE_PRICE_ID=price_...

# Webhook secret for handling Stripe events
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Your application URL (for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Email service (optional - for Formspree)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# Resend API (optional - for transactional emails)
# Get your key from: https://resend.com/
RESEND_API_KEY=re_...

# Cron job authentication
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Admin API key (for data population scripts)
# Generate a random key: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here
