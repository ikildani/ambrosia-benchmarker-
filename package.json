    "@sparticuz/chromium": "^143.0.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "dompurify": "^3.3.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.35.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.563.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.12",
    "next-nprogress-bar": "^2.4.7",
    "puppeteer-core": "^24.37.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "resend": "^6.9.1",
    "sonner": "^2.0.7",
    "stripe": "^20.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
