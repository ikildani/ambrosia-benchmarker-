    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "fast-check": "^4.6.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.38",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5",
    "undici": "^7.20.0"
