{
  "functions": {
    "app/api/report/generate/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/lead-scores",
      "schedule": "0 6 * * *"
    },
    {
