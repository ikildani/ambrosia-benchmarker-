      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/trials-update",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 12 * * 1"
    }
  ]
}
