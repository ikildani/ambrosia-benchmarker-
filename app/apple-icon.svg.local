<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" fill="none">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0d9488;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="180" height="180" rx="40" fill="url(#grad1)"/>
  <!-- DNA Helix -->
  <path d="M55 45 Q90 67 55 90 Q20 113 55 135" stroke="white" stroke-width="10" fill="none" stroke-linecap="round"/>
  <path d="M125 45 Q90 67 125 90 Q160 113 125 135" stroke="white" stroke-width="10" fill="none" stroke-linecap="round"/>
  <!-- Connection lines -->
  <line x1="55" y1="55" x2="125" y2="55" stroke="white" stroke-width="7" stroke-linecap="round" opacity="0.85"/>
  <line x1="55" y1="90" x2="125" y2="90" stroke="white" stroke-width="7" stroke-linecap="round" opacity="0.85"/>
  <line x1="55" y1="125" x2="125" y2="125" stroke="white" stroke-width="7" stroke-linecap="round" opacity="0.85"/>
</svg>
